# Verification token shown on the Ko-fi webhook page (https://ko-fi.com/manage/webhooks)
KOFI_WEBHOOK_VERIFICATION_TOKEN=your-kofi-verification-token

# Secret for GitHub Sponsors webhooks (X-Hub-Signature-256). Create the webhook
# in the sponsorable repo: Settings → Webhooks → Add webhook → content type
# application/json → events: Sponsorships.
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# GitHub Personal Access Token with `repo` scope (classic) or fine-grained with
# Contents read/write on the donations repo, used to push donations.json via the
# GitHub Contents API. Create at https://github.com/settings/tokens
GITHUB_PAT=ghp_your_personal_access_token

# Optional: override the donations repo (default: gaston1799/ko-fi-donations)
# KOFI_DONATIONS_REPO=your-org/your-donations-repo
